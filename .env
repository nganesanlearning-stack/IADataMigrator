# Environment variables for Airflow Docker setup

# Airflow Core Settings
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Airflow Web UI Credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin123

# Java Environment Settings
JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# Additional Python packages (if needed)
_PIP_ADDITIONAL_REQUIREMENTS=

# Database Settings (using default PostgreSQL)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true

# Logging
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# Security
AIRFLOW__WEBSERVER__SECRET_KEY=your-secret-key-here-change-this-in-production

#PostgreSQL configuration for Authentication and Metrics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=RND
POSTGRES_USER=postgres
POSTGRES_PASSWORD=t2RumJVIH
POSTGRES_SSL=false
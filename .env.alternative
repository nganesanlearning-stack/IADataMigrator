# Alternative approach: Use environment variable to install Java via existing mechanisms
# This avoids building a custom image

# Environment variables for existing docker-compose setup
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Airflow Web UI Credentials  
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Use pre-built image with Java (if available) or install via init script
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.2

# Additional Python packages for Java integration
_PIP_ADDITIONAL_REQUIREMENTS=py4j==0.10.9.7 jaydebeapi==1.2.3

# Database Settings
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true

# Logging
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# Security
AIRFLOW__WEBSERVER__SECRET_KEY=your-secret-key-here-change-this-in-production
